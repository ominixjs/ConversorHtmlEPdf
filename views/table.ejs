<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tabela</title>

    <style>
      table {
  font-family: Arial, Helvetica, sans-serif;
  border-collapse: collapse;
  width: 100%;
}

td,
th {
  border: 1px solid #ddd;
  padding: 8px;
}

tr:nth-child(even) {
  background-color: #f2f2f2;
}

tr:hover {
  background-color: #ddd;
}

th {
  padding-top: 12px;
  padding-bottom: 12px;
  text-align: left;
  background-color: #04aa6d;
  color: white;
}
    </style>
  </head>
  <body>
    <table>
      <thead>
        <tr>
        <% header.forEach(col => { %>
          <th><%= col %></th>
        <%})%>
        </tr>
      </thead>

      <tbody>
        <% rows.forEach(row => { %>
          <tr>
             <% row.forEach(element => { %>
              <td><%= element %></td>
             <%})%>
          </tr>
        <%})%>
      </tbody>
    </table>
  </body>
</html>
